      "ok": false,
      "reason": "Unsupported protocol version 2",
      "encoded": true
    },
    {
      "json": "{\"reason\":\"Pairing code expired or already used\",\"ok\":false,\"extra\":1}",
      "ok": false,
      "reason": "Pairing code expired or already used",
      "encoded": false
    }
  ]
